{
  "name": "tiny-osaka",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test",
    "test:db-config": "node --test tests/unit/db-config.test.mjs",
    "test:db-connection": "node --conditions=react-server --env-file=.env.local --env-file=.env.test.local --test tests/integration/db-connection.test.mjs",
    "db:migrate:test": "node --env-file=.env.test-migrator.local scripts/migrate-test-db.mjs",
    "db:migrate:dev": "node --env-file=.env.dev-migrator.local scripts/migrate-dev-db.mjs",
    "test:catalog-db": "node --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/catalog-constraints.test.mjs",
    "test:pricing-db": "node --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/pricing-constraints.test.mjs",
    "test:drafts-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/catalog-drafts.test.mjs",
    "test:clone-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/catalog-clone.test.mjs",
    "test:translations-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/catalog-translations.test.mjs",
    "test:variants-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/catalog-variants.test.mjs",
    "test:modifiers-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/catalog-modifiers.test.mjs",
    "test:foundation-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/catalog-foundation.test.mjs",
    "test:workflow-unit": "node --conditions=react-server --test tests/unit/catalog-content-hash.test.mjs tests/unit/catalog-workflow.test.mjs",
    "test:catalog-regression": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test --test-concurrency=1 tests/integration/catalog-constraints.test.mjs tests/integration/pricing-constraints.test.mjs tests/integration/catalog-drafts.test.mjs tests/integration/catalog-clone.test.mjs tests/integration/catalog-translations.test.mjs tests/integration/catalog-variants.test.mjs tests/integration/catalog-modifiers.test.mjs tests/integration/catalog-foundation.test.mjs",
    "test:publication-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/catalog-publication.test.mjs",
    "test:pages-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/pages.test.mjs",
    "test:media-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/media.test.mjs",
    "test:public-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test --test-concurrency=1 tests/integration/public-read.test.mjs tests/integration/public-order-links.test.mjs",
    "test:published-e2e": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local scripts/run-published-qa.mjs",
    "test:auth-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --test tests/integration/auth.test.mjs",
    "test:auth-e2e": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local scripts/run-auth-qa.mjs",
    "test:cms-pages-e2e": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --env-file=.env.cms.local scripts/run-cms-pages-qa.mjs",
    "test:cms-catalog-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --env-file=.env.cms.local --test tests/integration/cms-catalog.test.mjs tests/integration/cms-catalog-image.test.mjs tests/integration/cms-catalog-links.test.mjs",
    "test:cms-catalog-e2e": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --env-file=.env.cms.local scripts/run-cms-catalog-qa.mjs",
    "test:catalog-delete-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --env-file=.env.cms.local --test tests/integration/catalog-delete.test.mjs",
    "test:catalog-cards-unit": "node --conditions=react-server --test tests/unit/catalog-product-input.test.mjs tests/unit/catalog-variants-report.test.mjs tests/unit/media-cache-headers.test.mjs tests/unit/catalog-order-links.test.mjs tests/unit/catalog-cards-ui.test.mjs",
    "catalog:variants-report": "node --env-file=.env.cms.local scripts/catalog-variants-report.mjs",
    "test:cms-media-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --env-file=.env.cms.local --test tests/integration/cms-media.test.mjs",
    "test:cms-catalog-security-db": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --env-file=.env.cms.local --test --test-concurrency=1 tests/integration/cms-catalog-http.test.mjs tests/integration/cms-catalog-concurrency.test.mjs",
    "security:check": "npm audit --omit=dev --audit-level=high && npm run test:auth-db && npm run test:cms-catalog-security-db && node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --env-file=.env.cms.local scripts/security-check.mjs",
    "test:cms-media-e2e": "node --conditions=react-server --env-file=.env.test-migrator.local --env-file=.env.test.local --env-file=.env.cms.local scripts/run-cms-media-qa.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.58.0",
    "next": "16.4.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3"
  }
}
