# Template only. scripts/setup-local-db.ps1 provisions local LOGIN roles
# and writes private ignored .env.local / .env.test.local after approval.
# Copy into an ignored local env file; never use the postgres administrator.
# DATABASE_URL=postgresql://tiny_osaka_dev_app:REPLACE_LOCALLY@127.0.0.1:5432/tiny_osaka_dev
# TEST_DATABASE_URL=postgresql://tiny_osaka_test_app:REPLACE_LOCALLY@127.0.0.1:5432/tiny_osaka_test
# Separate migration credential; never copy into the public app env.
# scripts/setup-test-migrator.ps1 writes .env.test-migrator.local after approval.
# TEST_MIGRATION_DATABASE_URL=postgresql://tiny_osaka_test_migrator:REPLACE_LOCALLY@127.0.0.1:5432/tiny_osaka_test
# scripts/setup-dev-migrator.ps1 writes separate private .env.dev-migrator.local.
# DEV_MIGRATION_DATABASE_URL=postgresql://tiny_osaka_dev_migrator:REPLACE_LOCALLY@127.0.0.1:5432/tiny_osaka_dev

# Public server rendering: published (default) or explicit local fixture preview.
PUBLIC_CONTENT_SOURCE=published
PUBLIC_DATABASE_TARGET=dev

# Auth secret is generated into ignored, private .env.auth.local by scripts/setup-auth.ps1.
# Runtime reads that file on the server only; never add NEXT_PUBLIC_ to these keys.
# BETTER_AUTH_SECRET=REPLACE_LOCALLY
# BETTER_AUTH_URL=http://localhost:3000

# scripts/setup-cms.ps1 creates isolated local CMS logins and private .env.cms.local.
# CMS_DATABASE_URL=postgresql://tiny_osaka_dev_cms:REPLACE_LOCALLY@127.0.0.1:5432/tiny_osaka_dev
# TEST_CMS_DATABASE_URL=postgresql://tiny_osaka_test_cms:REPLACE_LOCALLY@127.0.0.1:5432/tiny_osaka_test

# Optional, operator-installed video inspection tools. Absolute executable paths.
# Configure both in private .env.local; no binaries are downloaded by this app.
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# FFPROBE_PATH=C:/path/to/ffprobe.exe
